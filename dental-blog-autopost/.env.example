# 블로그 글 생성에 쓰는 Anthropic API 키 (console.anthropic.com)
ANTHROPIC_API_KEY=

# Google Cloud Console에서 발급한 OAuth 클라이언트 (애플리케이션 유형: 데스크톱 앱)
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
# scripts/get-refresh-token.mjs 로 1회 발급
BLOGGER_REFRESH_TOKEN=
# healthydentalwonju.blogspot.com 블로그의 숫자 ID
BLOGGER_BLOG_ID=

# Vercel Marketplace의 Upstash Redis 연동 시 자동 주입되는 이름 그대로
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 아무 값이나 직접 정해서 채우면 됨 (openssl rand -hex 32 등). Vercel Cron이 보내는
# Authorization: Bearer <이 값> 헤더를 검증해서 외부에서 무단 호출하는 걸 막는 용도.
CRON_SECRET=

# Instagram (API with Instagram Login) — 앱 설정 기본이 아니라 Instagram 전용 앱ID/시크릿.
# scripts/get-instagram-token.mjs 로 1회 발급받은 뒤 IG_ACCESS_TOKEN은 Redis에 시딩하고
# (instagram:access_token / instagram:token_refreshed_at), 여기엔 안 넣어도 됨 — 코드가
# Redis에서 읽고 24시간마다 알아서 갱신한다.
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=

# 영상 공개 호스팅용 (Instagram/Threads가 fetch할 수 있어야 함). vercel blob create-store로 생성.
BLOB_READ_WRITE_TOKEN=

# Threads (별도 앱, Instagram/Facebook과 다른 자격증명) — 아직 게시 미검증, SKILL.md 참고
THREADS_APP_ID=
THREADS_APP_SECRET=
