{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai-visibility-check.py\"",
            "timeout": 60,
            "statusMessage": "AI/검색 노출 상태 점검 중..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Nn]otion.*update-page",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-notion-replace.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}